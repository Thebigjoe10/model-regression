# Environment Variables for Solar Fish Dryer ML System

# ============================================
# Backend Configuration
# ============================================

# Port (usually set automatically by hosting platform)
PORT=5000

# Flask environment (development or production)
FLASK_ENV=production

# Python version (for deployment platforms)
PYTHON_VERSION=3.11.0

# ============================================
# Frontend Configuration
# ============================================

# Backend API URL (replace with your deployed backend URL)
REACT_APP_API_URL=http://localhost:5000/api

# For production, use your actual backend URL:
# REACT_APP_API_URL=https://your-backend.onrender.com/api

# ============================================
# Optional Configuration
# ============================================

# Number of gunicorn workers (default: 2)
# WEB_CONCURRENCY=2

# Gunicorn timeout in seconds (default: 120)
# GUNICORN_TIMEOUT=120

# ============================================
# Instructions
# ============================================
#
# For local development:
# 1. Copy this file to .env
# 2. Update values as needed
# 3. Load with: source .env (Mac/Linux) or set in PowerShell (Windows)
#
# For deployment (Render/Railway/Vercel):
# 1. Add these as environment variables in the platform dashboard
# 2. Update REACT_APP_API_URL to your actual backend URL
#
